# Client portal (Supabase) -- create a NEW, SEPARATE Supabase project for
# this app (do not reuse the Sequence project). Steps:
#   1. Create the project at supabase.com.
#   2. Run client_portal_schema.sql in its SQL editor.
#   3. Paste the URL + keys below (Project Settings -> API).
#   4. In Auth -> URL Configuration, add this site's domain(s) plus
#      "/auth/callback" to Redirect URLs so magic links work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form (Resend) -- see app/api/contact/route.ts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
